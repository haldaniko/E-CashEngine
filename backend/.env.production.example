NODE_ENV=production
PORT=4000
DATABASE_PATH=/host-data/db.sqlite3
REDIS_URL=redis://redis:6379
TRUST_PROXY=true
UPLOAD_DIR=/host-data/media
CORS_ORIGIN=https://e-cashingengine.com
SITE_URL=https://e-cashingengine.com
BOT_INTEGRATION_TOKEN=replace-with-a-random-bot-integration-secret
JWT_SECRET=replace-with-generated-stable-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-generated-stable-secret
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_SITE_URL=https://e-cashingengine.com
OPENROUTER_TIMEOUT_MS=90000
OPENROUTER_MAX_INPUT_CHARS=16000
OPENROUTER_MAX_OUTPUT_TOKENS=9000
OPENROUTER_TEMPERATURE=0.7
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
